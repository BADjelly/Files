<ContentDialog
	x:Class="Files.App.Dialogs.VersionHistoryDialog"
	x:Name="ThisDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:Files.App.Controls"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:helpers="using:Files.App.Helpers"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:models="using:Files.App.Data.Models"
	xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
	xmlns:wctconverters="using:CommunityToolkit.WinUI.Converters"
	CornerRadius="{StaticResource OverlayCornerRadius}"
	DefaultButton="Primary"
	HighContrastAdjustment="None"
	PrimaryButtonClick="ContentDialog_PrimaryButtonClick"
	PrimaryButtonText="{helpers:ResourceString Name=Close}"
	RequestedTheme="{x:Bind RootAppElement.RequestedTheme, Mode=OneWay}"
	SecondaryButtonText="{helpers:ResourceString Name=Cancel}"
	Style="{StaticResource DefaultContentDialogStyle}"
	mc:Ignorable="d">

	<ContentDialog.Resources>
		<wctconverters:EmptyCollectionToObjectConverter
			x:Key="NotEmptyToTrueConverter"
			EmptyValue="False"
			NotEmptyValue="True" />
	</ContentDialog.Resources>

				<!--  Version history list  -->
				<Grid RowSpacing="12">
					<Grid.RowDefinitions>
						<RowDefinition Height="*" />
					</Grid.RowDefinitions>

					<ListView
						x:Name="HistoryListView"
						Grid.Row="0"
						MaxHeight="375"
						Width="400"
						ItemsSource="{x:Bind ViewModel.HistoryItems, Mode=OneWay}">
						<ListView.ItemTemplate>
							<DataTemplate x:DataType="helpers:VersionHistoryItem">
								<Grid ColumnSpacing="8">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*" />
										<ColumnDefinition Width="Auto" />
									</Grid.ColumnDefinitions>
									<StackPanel Grid.Column="0" Margin="8,12" Spacing="4">
										<TextBlock Text="{x:Bind Timestamp, Mode=OneWay}" FontWeight="SemiBold" />
										<TextBlock Text="{x:Bind Title, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
										<TextBlock Text="{x:Bind Description, Mode=OneWay}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" FontSize="12" />
										<ItemsControl x:Name="TagsItemsControl" ItemsSource="{x:Bind Tags, Mode=OneWay}" Margin="0,4,0,0" x:Load="{x:Bind Tags, Mode=OneWay, Converter={StaticResource NotEmptyToTrueConverter}}">
											<ItemsControl.ItemsPanel>
												<ItemsPanelTemplate>
													<toolkit:WrapPanel Orientation="Horizontal" VerticalSpacing="4" />
												</ItemsPanelTemplate>
											</ItemsControl.ItemsPanel>
											<ItemsControl.ItemTemplate>
												<DataTemplate x:DataType="models:TagViewModel">
													<StackPanel
														Height="20"
														Padding="8,0"
														VerticalAlignment="Center"
														Background="{ThemeResource SubtleFillColorTransparent}"
														CornerRadius="10"
														Orientation="Horizontal"
														Spacing="4">
														<controls:ThemedIcon
															Width="12"
															Height="12"
															IconColorType="Custom"
															IsFilled="True"
															Style="{StaticResource App.ThemedIcons.Tag}"
															Color="{x:Bind Color}" />
														<TextBlock
															VerticalAlignment="Center"
															FontSize="12"
															Text="{x:Bind Name}" />
													</StackPanel>
												</DataTemplate>
											</ItemsControl.ItemTemplate>
										</ItemsControl>
									</StackPanel>
									<StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
										<Button Content="{helpers:ResourceString Name=Open}" Padding="8,4" Click="OpenButton_Click" Tag="{Binding}" />
										<Button Content="{helpers:ResourceString Name=VersionHistoryShow}" Padding="8,4" Click="ShowButton_Click" Tag="{Binding}" />
									</StackPanel>
								</Grid>
							</DataTemplate>
						</ListView.ItemTemplate>
					</ListView>
				</Grid>
			</ContentDialog>
